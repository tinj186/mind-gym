generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model StudentProfile {
  id            String           @id @default(uuid())
  name          String           @default("Default Student") // Temporary default for existing rows
  externalId    String           @unique @default("default-external-id") // Temporary default for existing rows
  primaryLevel  String?          // Stores the auto-saved division (e.g., "Primary 1")
  mastery       StudentMastery[]
  activeWorkout Json?            // Stores { questionIds: String[], currentIndex: Int, answersLog: Json }
  
  // Gamification tracking
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  lastPracticeDate DateTime?

  createdAt     DateTime         @default(now()) // Added for sorting
  mockExamResults MockExamResult[]
}

model StudentMastery {
  id              String   @id @default(uuid())
  studentId       String   @default("default-student") // Track individual student
  student         StudentProfile @relation(fields: [studentId], references: [id])
  subject         String   @default("Math")
  level           String   @default("Primary 4")
  topic           String
  subtopic        String?
  topicId         String   // Phase 3 Identifier
  subTopicId      String?  // Phase 3 Identifier
  synapseStrength Int      @default(0)    // Range: 0-100
  fluencyMetrics  Json?
  totalReps       Int      @default(0)
  defectLog       Json?    @default("{}") // Stores frequency of Defect Codes (e.g., CARELESS_CALCULATION)
  consecutiveWins Int      @default(0)
  lastTrained     DateTime @updatedAt

  // Ensure one mastery record per student per subtopic
  @@unique([studentId, topicId, subTopicId])
}

model QuestionBank {
  id          String   @id @default(uuid())
  subject     String   @default("Math")
  strand      String?  // e.g., "Number and Algebra", "Measurement and Geometry"
  level       String   @default("Primary 4")
  gradeLevel  String   // e.g., "P1", "P5" - Used by AI for syllabus mapping
  heuristic   String   // e.g., "PART_WHOLE", "UNITS_PARTS" - Used by AI for prompt generation
  topic       String
  subtopic    String?
  type        String   // MCQ, Short, Structured
  difficulty  String   // Easy, Medium, Hard
  question    String   @db.Text
  options     Json?    // Stores ["A: ..", "B: ..", "C: ..", "D: .."] or null for MCQ
  modelData   Json?    // Visual Bar Model coordinates/values
  visualItems Json?    // Legacy column for bridged items
  hint        String?  @db.Text // Conceptual hint for "Spotter" system
  solution    String   @db.Text
  finalAnswer String
  isApproved  Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relation: One question can have many attempts
  attempts    AttemptLog[]
}

model AttemptLog {
  id            String   @id @default(uuid())
  studentId     String   @default("default-student")
  isCorrect     Boolean      // Tier 1: Final numeric match
  isLogicCorrect   Boolean?     // Tier 2/3: AI's assessment of the bar model logic
  studentAnswer String?      
  modelDescription String?      @db.Text // The serialized "story" of the bars
  attempts      Int          @default(1) // Number of attempts taken
  assistedCorrect Boolean    @default(false) // True if answered correctly after a hint
  timeSpentSecs Int
  defectCode       String?      // e.g., "CONSTANT_VIOLATION"
  gradingTier      Int          @default(1) 
  createdAt     DateTime @default(now())

  // Relation: Link attempt back to the question
  questionId    String
  question      QuestionBank @relation(fields: [questionId], references: [id])
}

model SystemConfig {
  key   String @id
  value Json
}

model MockExamResult {
  id              String   @id @default(uuid())
  studentId       String   @default("default-student")
  student         StudentProfile @relation(fields: [studentId], references: [id])
  topicId         String
  topic           String
  accuracy        Int      @default(0) // Timed Exam Performance %
  speedAnalysis   Json?    @default("{}") 
  errorPatterns   Json?    @default("[]") 
  sectionBreakdown Json?   @default("{}") 
  createdAt       DateTime @default(now())
}